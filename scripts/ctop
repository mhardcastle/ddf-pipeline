#!/usr/bin/env bash
# ctop — real-time SLURM cluster monitor
#
# Usage:  ctop [partition] [refresh_seconds]
#         ctop genoa          → watch 'genoa' partition, refresh every 5s
#         ctop genoa 10       → same but refresh every 10s
#         ctop                → defaults: partition=genoa, interval=5s
#
# Arguments (both optional, order matters):
#   partition        SLURM partition name to monitor  (default: genoa)
#   refresh_seconds  Screen refresh interval in secs  (default: 5)
#
# Environment:
#   PEND_MIN_NODES   only pending jobs of at least this many nodes (default 10)
#   PEND_ALL=1       one line per pending job instead of grouping identical ones
#
# Pending jobs: identical jobs (same user/account, nodes, time limit, reason) are grouped (×count,
# waiting = oldest~newest). The reason shows the queue rank by priority among the eligible pending
# jobs of the partition and the nodes requested by the jobs ahead ("prio #12 (3.4kN ahead)"),
# "next #1, needs nodes" for the job SLURM is reserving nodes for, which limit for *Limit reasons,
# and who holds a held job.
#
# Keyboard: Ctrl+C to quit.
# NOTE: occupancy = SLURM allocation, not actual CPU utilisation.

# ── parse arguments ──────────────────────────────────────────────────────────
# First non-numeric arg = partition name; first numeric arg = interval
PARTITION="genoa"
INTERVAL=5
PEND_MIN_NODES=${PEND_MIN_NODES:-10}

for arg in "$@"; do
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
        INTERVAL=$arg
    else
        PARTITION=$arg
    fi
done

ME=${USER}

# ── validate partition ────────────────────────────────────────────────────────
_list_partitions() {
    printf "\033[1mAvailable partitions:\033[0m\n"
    sinfo -h -o "%20P %8l %6D %6c %G" 2>/dev/null | sort | \
    while read -r part timelim nodes cpus features; do
        [[ "$part" == *"*"* ]] && def="\033[32m(default)\033[0m" || def=""
        printf "  \033[33m%-20s\033[0m  timelimit:%-10s  nodes:%-5s  cpus/node:%-5s  %s\n" \
               "$part" "$timelim" "$nodes" "$cpus" "$def"
    done
}

if [[ "${1:-}" == "list" ]]; then
    _list_partitions
    exit 0
fi

if ! sinfo -h -o "%P" 2>/dev/null | grep -q "^${PARTITION}\*\?$"; then
    printf "[31mError:[0m partition [33m%s[0m not found.

" "$PARTITION"
    _list_partitions
    exit 1
fi

# ── validate partition ────────────────────────────────────────────────────────
_available_partitions() {
    sinfo -h -o "%P" 2>/dev/null | sed 's/\*$//' | sort -u
}

if ! sinfo -p "$PARTITION" -h &>/dev/null || [[ -z "$(sinfo -p "$PARTITION" -h 2>/dev/null)" ]]; then
    echo "Error: partition '$PARTITION' not found." >&2
    echo "" >&2
    echo "Available partitions:" >&2
    _available_partitions | while read -r p; do
        n_nodes=$(sinfo -p "$p" -h -o "%D" 2>/dev/null | awk '{s+=$1}END{print s}')
        printf "  %-20s (%s nodes)\n" "$p" "$n_nodes" >&2
    done
    exit 1
fi

expand_nodelist() {
    local nl="$1"
    [[ -z "$nl" || "$nl" == "(null)" ]] && return
    scontrol show hostnames "$nl" 2>/dev/null
}

# ── typical wait time by node-count + requested-walltime bucket ────────────
# Looks at jobs that started in the last 3 days on this partition and
# buckets their (start - submit) wait time by (how many nodes they asked
# for, how long they asked to run for), since both influence scheduling/
# backfill decisions -- a 2-node/1h job and a 2-node/3-day job can have very
# different queue times.
#
# This can be a genuinely slow query on a busy accounting DB (many rows,
# each needing two `date -d` calls), so it is NEVER run in the foreground:
# it's launched as a background job at most once every TYPICAL_WAIT_TTL
# seconds, writes its result to a small cache file, and the main loop just
# reads that cache file (near-instant) every redraw. The screen never waits
# on sacct, no matter how long it takes.
TYPICAL_WAIT_TTL=300   # seconds between sacct refreshes (5 min)
CACHE_FILE="/tmp/.ctop_typical_wait_${PARTITION}_${UID}.cache"
LOCK_FILE="${CACHE_FILE}.lock"
declare -A TYPICAL_WAIT_SUM=()        # key "<nnodes>_<walltime_bucket_idx>"
declare -A TYPICAL_WAIT_CNT=()
declare -A TYPICAL_WAIT_SUM_ANYWT=()  # key "<nnodes>" -- fallback, ignores walltime
declare -A TYPICAL_WAIT_CNT_ANYWT=()

WALLTIME_BUCKET_LABELS=("<=1h" "<=4h" "<=12h" "<=24h" "<=72h" ">72h")

# Parse a SLURM duration string (SS | MM:SS | HH:MM:SS | D-HH:MM:SS) to seconds.
# Pure bash (no awk/cut forks) since this also runs once per historical row.
_dhms_to_secs() {
    local t="$1" d=0 h=0 m=0 s=0 parts
    if [[ -z "$t" || "$t" == "UNLIMITED" || "$t" == "Partition_Limit" ]]; then
        echo 999999999; return
    fi
    [[ "$t" == *-* ]] && { d="${t%%-*}"; t="${t#*-}"; }
    IFS=':' read -ra parts <<< "$t"
    case ${#parts[@]} in
        3) h=${parts[0]}; m=${parts[1]}; s=${parts[2]} ;;
        2) m=${parts[0]}; s=${parts[1]} ;;
        1) s=${parts[0]} ;;
        *) echo 999999999; return ;;
    esac
    echo $(( 10#${d:-0}*86400 + 10#${h:-0}*3600 + 10#${m:-0}*60 + 10#${s:-0} ))
}

_walltime_bucket_idx() {
    local secs=$1
    if   (( secs <= 3600     )); then echo 0
    elif (( secs <= 4*3600   )); then echo 1
    elif (( secs <= 12*3600  )); then echo 2
    elif (( secs <= 24*3600  )); then echo 3
    elif (( secs <= 72*3600  )); then echo 4
    else                              echo 5
    fi
}

# Runs only in the background. Queries sacct, buckets everything using pure
# bash string ops (one fork pair for `date -d` per row -- unavoidable -- but
# nothing else), and writes the result to CACHE_FILE atomically (via a temp
# file + mv) so the main loop never sees a half-written cache.
_compute_typical_wait_to_file() {
    local tmpfile="${CACHE_FILE}.tmp.$$"
    local submit start nnodes_h tlimit_h state_h
    local sub_epoch start_epoch wait_s t d h m s parts tsecs bidx key
    declare -A sum=() cnt=() sum_any=() cnt_any=()

    while IFS='|' read -r submit start nnodes_h tlimit_h state_h; do
        [[ -z "$submit" || "$submit" == "Unknown" || "$submit" == "None" ]] && continue
        [[ -z "$start"  || "$start"  == "Unknown" || "$start"  == "None" ]] && continue
        [[ "$nnodes_h" =~ ^[0-9]+$ ]] || continue
        sub_epoch=$(date -d "$submit" +%s 2>/dev/null) || continue
        start_epoch=$(date -d "$start" +%s 2>/dev/null) || continue
        wait_s=$(( start_epoch - sub_epoch ))
        (( wait_s < 0 )) && continue

        d=0; h=0; m=0; s=0; t="$tlimit_h"; tsecs=""
        if [[ -z "$t" || "$t" == "UNLIMITED" || "$t" == "Partition_Limit" ]]; then
            tsecs=999999999
        else
            [[ "$t" == *-* ]] && { d="${t%%-*}"; t="${t#*-}"; }
            IFS=':' read -ra parts <<< "$t"
            case ${#parts[@]} in
                3) h=${parts[0]}; m=${parts[1]}; s=${parts[2]} ;;
                2) m=${parts[0]}; s=${parts[1]} ;;
                1) s=${parts[0]} ;;
                *) tsecs=999999999 ;;
            esac
            [[ -z "$tsecs" ]] && tsecs=$(( 10#${d:-0}*86400 + 10#${h:-0}*3600 + 10#${m:-0}*60 + 10#${s:-0} ))
        fi
        if   (( tsecs <= 3600     )); then bidx=0
        elif (( tsecs <= 4*3600   )); then bidx=1
        elif (( tsecs <= 12*3600  )); then bidx=2
        elif (( tsecs <= 24*3600  )); then bidx=3
        elif (( tsecs <= 72*3600  )); then bidx=4
        else                              bidx=5
        fi

        key="${nnodes_h}_${bidx}"
        sum[$key]=$(( ${sum[$key]:-0} + wait_s ))
        cnt[$key]=$(( ${cnt[$key]:-0} + 1 ))
        sum_any[$nnodes_h]=$(( ${sum_any[$nnodes_h]:-0} + wait_s ))
        cnt_any[$nnodes_h]=$(( ${cnt_any[$nnodes_h]:-0} + 1 ))
    done < <(sacct -a -X -p --partition="$PARTITION" --starttime=now-3days \
                   --format=Submit,Start,NNodes,Timelimit,State 2>/dev/null | tail -n +2)

    : > "$tmpfile"
    for key in "${!cnt[@]}"; do
        echo "BUCKET|$key|${sum[$key]}|${cnt[$key]}" >> "$tmpfile"
    done
    for key in "${!cnt_any[@]}"; do
        echo "ANYWT|$key|${sum_any[$key]}|${cnt_any[$key]}" >> "$tmpfile"
    done
    mv -f "$tmpfile" "$CACHE_FILE"
    rm -f "$LOCK_FILE"
}

# Called every redraw. Never blocks: kicks off a background recompute if the
# cache is missing/stale and nothing is already running, then loads whatever
# is currently on disk (instant) into the in-memory arrays used for display.
_refresh_typical_wait() {
    if [[ -e "$LOCK_FILE" ]]; then
        # Guard against a crashed/killed background job leaving a stale lock
        # forever -- if it's older than 2x TTL, assume it's dead and clear it.
        local lock_age=$(( $(date +%s) - $(date -r "$LOCK_FILE" +%s 2>/dev/null || echo 0) ))
        (( lock_age > TYPICAL_WAIT_TTL * 2 )) && rm -f "$LOCK_FILE"
    fi
    if [[ ! -e "$LOCK_FILE" ]]; then
        local need_refresh=1
        if [[ -e "$CACHE_FILE" ]]; then
            local age=$(( $(date +%s) - $(date -r "$CACHE_FILE" +%s 2>/dev/null || echo 0) ))
            (( age < TYPICAL_WAIT_TTL )) && need_refresh=0
        fi
        if (( need_refresh )); then
            : > "$LOCK_FILE"
            ( _compute_typical_wait_to_file ) &
        fi
    fi

    TYPICAL_WAIT_SUM=(); TYPICAL_WAIT_CNT=()
    TYPICAL_WAIT_SUM_ANYWT=(); TYPICAL_WAIT_CNT_ANYWT=()
    if [[ -e "$CACHE_FILE" ]]; then
        local kind key csum ccnt
        while IFS='|' read -r kind key csum ccnt; do
            case "$kind" in
                BUCKET) TYPICAL_WAIT_SUM[$key]=$csum; TYPICAL_WAIT_CNT[$key]=$ccnt ;;
                ANYWT)  TYPICAL_WAIT_SUM_ANYWT[$key]=$csum; TYPICAL_WAIT_CNT_ANYWT[$key]=$ccnt ;;
            esac
        done < "$CACHE_FILE"
    fi
}

# Given a requested node count and requested walltime (seconds), find the
# closest node-count bucket *within the same walltime range* that has at
# least 2 samples ("~1h30m (n=4,~4N,<=4h)"); if there isn't enough data in
# that walltime range, fall back to matching on node count alone, ignoring
# requested walltime, and flag that in the label ("(any wt)").
_typical_wait_str() {
    local want=$1 want_tsecs=$2 want_bidx best_n="" best_diff=999999 n key nn bidx diff
    want_bidx=$(_walltime_bucket_idx "$want_tsecs")

    for key in "${!TYPICAL_WAIT_CNT[@]}"; do
        nn="${key%_*}"; bidx="${key#*_}"
        [[ "$bidx" != "$want_bidx" ]] && continue
        (( ${TYPICAL_WAIT_CNT[$key]} < 2 )) && continue
        diff=$(( nn > want ? nn - want : want - nn ))
        if (( diff < best_diff )); then best_diff=$diff; best_n=$nn; fi
    done
    if [[ -n "$best_n" ]]; then
        local key="${best_n}_${want_bidx}"
        local avg=$(( TYPICAL_WAIT_SUM[$key] / TYPICAL_WAIT_CNT[$key] ))
        local h=$(( avg/3600 )) m=$(( (avg%3600)/60 ))
        printf "~%dh%02dm (n=%d,~%dN,%s)" "$h" "$m" "${TYPICAL_WAIT_CNT[$key]}" "$best_n" "${WALLTIME_BUCKET_LABELS[$want_bidx]}"
        return
    fi

    best_n=""; best_diff=999999
    for n in "${!TYPICAL_WAIT_CNT_ANYWT[@]}"; do
        (( ${TYPICAL_WAIT_CNT_ANYWT[$n]} < 2 )) && continue
        diff=$(( n > want ? n - want : want - n ))
        if (( diff < best_diff )); then best_diff=$diff; best_n=$n; fi
    done
    if [[ -n "$best_n" ]]; then
        local avg=$(( TYPICAL_WAIT_SUM_ANYWT[$best_n] / TYPICAL_WAIT_CNT_ANYWT[$best_n] ))
        local h=$(( avg/3600 )) m=$(( (avg%3600)/60 ))
        printf "~%dh%02dm (n=%d,~%dN,any wt)" "$h" "$m" "${TYPICAL_WAIT_CNT_ANYWT[$best_n]}" "$best_n"
        return
    fi
    echo "n/a"
}

while true; do
    _refresh_typical_wait

    # ── my jobs (running + pending) ────────────────────────────────────────
    declare -A MY_RUNNING=()
    declare -A MY_PENDING=()

    # Full job info for display
    MY_JOBS_RUNNING=""
    MY_JOBS_PENDING=""

    # Use | delimiter so empty %N (pending jobs) doesn't shift fields
    while IFS='|' read -r jobid jobstate nodes time timelimit name nodelist jobpart account reason submit; do
        [[ -z "$jobid" || "$jobid" == "JOBID" ]] && continue
        jobid=$(echo "$jobid" | tr -d ' ')
        reason=$(echo "$reason" | sed 's/^ *//')

        # Get allocation details from scontrol (one call, cached)
        _sctl=$(scontrol show job "$jobid" 2>/dev/null)
        cpus_per_task=$(grep -oP 'CPUs/Task=\K[0-9]+' <<< "$_sctl" | head -1)
        ntasks=$(grep -oP 'NumTasks=\K[0-9]+' <<< "$_sctl" | head -1)
        tasks_per_node=$(grep -oP 'NTasksPerN:GPU:Socket:Core=\K[0-9]+' <<< "$_sctl" | head -1)
        [[ -z "$cpus_per_task" ]] && cpus_per_task="?"
        [[ -z "$ntasks" ]] && ntasks="?"
        # Derive tasks/node from ntasks/nodes if SLURM didn't set NTasksPerNode
        if [[ -z "$tasks_per_node" || "$tasks_per_node" == "0" ]] && [[ "$nodes" =~ ^[0-9]+$ && "$nodes" -gt 0 && "$ntasks" =~ ^[0-9]+$ ]]; then
            tasks_per_node=$(( ntasks / nodes ))
        fi
        [[ -z "$tasks_per_node" ]] && tasks_per_node="?"

        # Convert HH:MM:SS or D-HH:MM:SS to seconds
        _to_secs() {
            # SLURM formats: M:SS | H:MM:SS | D-H:MM:SS
            local t="$1" d=0 h=0 m=0 s=0
            [[ "$t" == *-* ]] && { d="${t%%-*}"; t="${t#*-}"; }
            local n; n=$(awk -F: '{print NF}' <<< "$t")
            case $n in
                3) h=$(cut -d: -f1 <<< "$t"); m=$(cut -d: -f2 <<< "$t"); s=$(cut -d: -f3 <<< "$t") ;;
                2) m=$(cut -d: -f1 <<< "$t"); s=$(cut -d: -f2 <<< "$t") ;;
                1) s=$t ;;
            esac
            echo $(( d*86400 + 10#${h:-0}*3600 + 10#${m:-0}*60 + 10#${s:-0} ))
        }
        _pbar() {
            local pct=$1 f e bar=""
            f=$(( pct * 12 / 100 )); e=$(( 12 - f ))
            for ((i=0;i<f;i++)); do bar+="█"; done
            for ((i=0;i<e;i++)); do bar+="░"; done
            echo "$bar"
        }

        case "$jobstate" in
            RUNNING)
                elapsed_s=$(_to_secs "$time")
                limit_s=$(_to_secs "$timelimit")
                if [[ $limit_s -gt 0 ]]; then
                    pct=$(( elapsed_s * 100 / limit_s ))
                    [[ $pct -gt 100 ]] && pct=100
                    [[ $pct -gt 100 ]] && pct=100
                    left_s=$(( limit_s - elapsed_s ))
                    [[ $left_s -lt 0 ]] && left_s=0
                    [[ $left_s -lt 0 ]] && left_s=0
                    left_h=$(( left_s / 3600 ))
                    left_m=$(( (left_s % 3600) / 60 ))
                    left_str=$(printf "%dh%02dm" $left_h $left_m)
                else
                    pct=0; left_str="?"
                fi
                account="${account%%_*}"   # strip partition suffix e.g. cad17819_genoa→cad17819
                bar=$(_pbar $pct)
                MY_JOBS_RUNNING+=$(printf "  \033[1;36m%-12s\033[0m %-12s %-8s [%-10s] %sN×%st×%sc  \033[90m%s\033[0m %3d%%  left:%-8s  on: %s" \
                    "$jobid" "$name" "$account" "$jobpart" "$nodes" "$tasks_per_node" "$cpus_per_task" \
                    "$bar" "$pct" "$left_str" "$nodelist")
                MY_JOBS_RUNNING+=$'\n'
                while read -r node; do
                    [[ -n "$node" ]] && MY_RUNNING["$node"]=1
                done < <(expand_nodelist "$nodelist")
                ;;
            PENDING)
                start=$(squeue --me -h -j "$jobid" --start -o "%S" 2>/dev/null)
                [[ -z "$start" ]] && start="N/A"
                twait=$(_typical_wait_str "$nodes" "$(_dhms_to_secs "$timelimit")")
                if [[ -n "$submit" && "$submit" != "Unknown" && "$submit" != "N/A" ]]; then
                    submit_epoch=$(date -d "$submit" +%s 2>/dev/null)
                    if [[ -n "$submit_epoch" ]]; then
                        waited_s=$(( $(date +%s) - submit_epoch ))
                        [[ $waited_s -lt 0 ]] && waited_s=0
                        wd=$(( waited_s/86400 )); wh=$(( (waited_s%86400)/3600 )); wm=$(( (waited_s%3600)/60 ))
                        if   [[ $wd -gt 0 ]]; then waited_str=$(printf "%dd%02dh" "$wd" "$wh")
                        elif [[ $wh -gt 0 ]]; then waited_str=$(printf "%dh%02dm" "$wh" "$wm")
                        else                       waited_str=$(printf "%dm" "$wm"); fi
                        submitted_str="${submit} (${waited_str} ago)"
                    else
                        submitted_str="$submit"
                    fi
                else
                    submitted_str="N/A"
                fi
                MY_JOBS_PENDING+=$(printf "  \033[1;34m%-12s\033[0m %-12s %-8s [%-10s] %sN×%st×%sc  req:%-11s submitted: %s\n                  est.start: %-14s typ.wait: %-30s reason: %s" \
                    "$jobid" "$name" "$account" "$jobpart" "$nodes" "$tasks_per_node" "$cpus_per_task" "$timelimit" "$submitted_str" "$start" "$twait" "$reason")
                MY_JOBS_PENDING+=$'\n'
                while read -r node; do
                    [[ -n "$node" ]] && MY_PENDING["$node"]=1
                done < <(expand_nodelist "$nodelist")
                ;;
        esac
    done < <(squeue -u "$ME" -h -o "%i|%T|%D|%M|%l|%j|%N|%P|%a|%R|%V" 2>/dev/null)

    my_running_nodes=${#MY_RUNNING[@]}
    my_pending_nodes=${#MY_PENDING[@]}

    # ── collect sinfo data ─────────────────────────────────────────────────
    mapfile -t LINES < <(sinfo -p "$PARTITION" -h -o "%n %C %T" | sort)

    N=${#LINES[@]}
    total_alloc=0; total_cores=0
    n_idle=0; n_full=0; n_part=0; n_down=0
    declare -a PCTS=()
    declare -a NODES=()
    declare -a STATES=()

    for line in "${LINES[@]}"; do
        read -r node cpuinfo state <<< "$line"
        alloc=$(cut -d/ -f1 <<< "$cpuinfo")
        cores=$(cut -d/ -f4 <<< "$cpuinfo")
        [[ $cores -eq 0 ]] && continue
        pct=$(( alloc * 100 / cores ))
        PCTS+=("$pct"); NODES+=("$node"); STATES+=("$state")
        total_alloc=$(( total_alloc + alloc ))
        total_cores=$(( total_cores + cores ))
        case "$state" in
            idle*)  (( n_idle++ ))  ;;
            alloc*) (( n_full++ ))  ;;
            mixed*) (( n_part++ ))  ;;
            *)      (( n_down++ ))  ;;
        esac
    done

    global_pct=$(( total_cores > 0 ? total_alloc * 100 / total_cores : 0 ))

    # ── render ─────────────────────────────────────────────────────────────
    clear

    # ── terminal width ────────────────────────────────────────────────────────
    TERM_W=$(tput cols 2>/dev/null || echo 100)
    TERM_H=$(tput lines 2>/dev/null || echo 40)   # ($LINES is the sinfo array, see mapfile above)
    MAP_COLS=$(( (TERM_W - 4) / 2 ))
    [[ $MAP_COLS -lt 10 ]] && MAP_COLS=10

    # ── header ─────────────────────────────────────────────────────────────
    printf "\033[1mGenoa cluster load\033[0m  \033[90m(SLURM allocation — not actual CPU usage)\033[0m\n"
    printf "%s  partition: %s  user: %s  refresh: %ds\n" \
           "$(date '+%H:%M:%S')" "$PARTITION" "$ME" "$INTERVAL"
    echo

    # ── global bar ─────────────────────────────────────────────────────────
    BAR=60
    filled=$(( global_pct * BAR / 100 ))
    empty=$(( BAR - filled ))
    if   [[ $global_pct -ge 90 ]]; then col='\033[31m'
    elif [[ $global_pct -ge 60 ]]; then col='\033[33m'
    else                                col='\033[32m'; fi
    bar=$(printf '█%.0s' $(seq 1 $filled))
    bar+=$(printf '░%.0s' $(seq 1 $empty))
    printf "  Overall  ${col}%s\033[0m  %d%%   %d / %d cores\n" \
           "$bar" "$global_pct" "$total_alloc" "$total_cores"
    printf "  Nodes (%d):  \033[32m%d idle\033[0m  \033[33m%d partial\033[0m  \033[31m%d full\033[0m  \033[90m%d down\033[0m\n" \
           "$N" "$n_idle" "$n_part" "$n_full" "$n_down"
    echo

    # ── legend + 2-D map ───────────────────────────────────────────────────
    printf "  \033[90m░░\033[0m idle  \033[32m██\033[0m<50%%  \033[33m██\033[0m<80%%  \033[31m██\033[0m<95%%  \033[35m██\033[0m100%%  \033[90m──\033[0m down  \033[1;36m██\033[0m MY·run  \033[1;34m◈◈\033[0m MY·pend\n"
    printf "  "
    COLS=$MAP_COLS; col_idx=0
    for i in "${!PCTS[@]}"; do
        pct="${PCTS[$i]}"; node="${NODES[$i]}"; state="${STATES[$i]}"
        if   [[ -n "${MY_RUNNING[$node]:-}" ]]; then cell='\033[1;36m██\033[0m'
        elif [[ -n "${MY_PENDING[$node]:-}" ]]; then cell='\033[1;34m◈◈\033[0m'
        elif [[ "$state" == down* || "$state" == drain* ]]; then cell='\033[90m──\033[0m'
        elif [[ $pct -eq 100 ]]; then cell='\033[35m██\033[0m'
        elif [[ $pct -ge 95  ]]; then cell='\033[31m██\033[0m'
        elif [[ $pct -ge 80  ]]; then cell='\033[33m██\033[0m'
        elif [[ $pct -ge  1  ]]; then cell='\033[32m██\033[0m'
        else                          cell='\033[90m░░\033[0m'
        fi
        printf "$cell"
        (( col_idx++ ))
        if (( col_idx % COLS == 0 )); then printf "\n  "; fi
    done
    echo; echo

    # ── my jobs section ────────────────────────────────────────────────────
    printf "\033[1m  ── My jobs ─────────────────────────────────────────────────────────\033[0m\n"

    if [[ -n "$MY_JOBS_RUNNING" ]]; then
        printf "\033[1;36m  ▶ RUNNING  (%d node(s))\033[0m\n" "$my_running_nodes"
        printf "%b\n" "$MY_JOBS_RUNNING"
    fi

    if [[ -n "$MY_JOBS_PENDING" ]]; then
        printf "\033[1;34m  ◷ PENDING  (%d node(s) planned)\033[0m\n" "$my_pending_nodes"
        printf "%b\n" "$MY_JOBS_PENDING"
    fi

    if [[ -z "$MY_JOBS_RUNNING" && -z "$MY_JOBS_PENDING" ]]; then
        printf "  \033[90mNo jobs in queue\033[0m\n"
    fi

    # ── side-by-side running / pending ──────────────────────────────────
    PBAR_W=26
    COL_W=$(( (TERM_W - 3) / 2 ))
    WB=8

    ansi_pad() {
        local s="$1" w="$2"
        local vis
        vis=$(printf '%b' "$s" | sed $'s/\033\\[[0-9;]*m//g' | LC_ALL=C.UTF-8 wc -m 2>/dev/null || printf '%b' "$s" | sed $'s/\033\\[[0-9;]*m//g' | wc -c)
        vis=$(( vis - 1 ))
        local pad=$(( w - vis ))
        [[ $pad -le 0 ]] && { printf '%b' "$s"; return; }
        printf '%b%*s' "$s" "$pad" ''
    }

    # Use temp files — more reliable than mapfile with nested pipelines
    TMP_RUN=$(mktemp); TMP_PND=$(mktemp)

    # ── running section → TMP_RUN ─────────────────────────────────────────
    {
        printf "\033[1m── Running (all, by nodes) ──────────────\033[0m\n"
        printf "\033[90m%-18s %6s %-5s avg%%  progress              soonest~latest_left\033[0m\n" "USER/account" "NODES" "jobs"
        printf "\033[90m%.${COL_W}s\033[0m\n" \
               "────────────────────────────────────────────────────────────────────────────"

        squeue -p "$PARTITION" -h -t RUNNING -o "%u|%a|%D|%M|%l" 2>/dev/null \
          | grep -v "^${ME}|" \
          | awk -F'|' -v pw="$PBAR_W" '
            function ts(t,  d,p,n){d=0
                if(match(t,/^[0-9]+-/)){d=substr(t,1,RLENGTH-1)+0;t=substr(t,RLENGTH+1)}
                n=split(t,p,":");if(n==3)return d*86400+p[1]*3600+p[2]*60+p[3]
                if(n==2)return d*86400+p[1]*60+p[2];return d*86400+p[1]}
            function fs(s,  d,h,m){if(s<0)s=0
                d=int(s/86400);s-=d*86400;h=int(s/3600);s-=h*3600;m=int(s/60)
                if(d>0)return d"d"sprintf("%02d",h)"h"
                if(h>0)return h"h"sprintf("%02d",m)"m";return m"m"}
            function pb(p,  f,e,b,i){f=int(p*pw/100);e=pw-f;b=""
                for(i=1;i<=f;i++)b=b"\xe2\x96\x88"
                for(i=1;i<=e;i++)b=b"\xe2\x96\x91";return b}
            {u=$1"/"$2;nd=$3+0;se=ts($4);sl=ts($5)
                tot[u]+=nd;cnt[u]++
                p=(sl>0)?int(se*100/sl):0;lf=(sl>se)?sl-se:0
                psum[u]+=p
                if(!(u in lfmin)||lf<lfmin[u])lfmin[u]=lf
                if(!(u in lfmax)||lf>lfmax[u])lfmax[u]=lf}
            END{n=0;for(u in tot)us[++n]=u
                for(i=1;i<=n;i++)for(j=i+1;j<=n;j++)
                    if(tot[us[i]]<tot[us[j]]){t=us[i];us[i]=us[j];us[j]=t}
                for(i=1;i<=n;i++){u=us[i];nj=cnt[u]
                    avg=int(psum[u]/nj)
                    if(nj==1 || lfmin[u]==lfmax[u])tl=fs(lfmin[u])
                    else tl=fs(lfmin[u])"~"fs(lfmax[u])
                    printf "%s|%d|%d|%d|%s|%s\n",u,tot[u],nj,avg,pb(avg),tl}}' \
          | while IFS='|' read -r user nodes njobs pct bar left; do
                [[ -z "$user$nodes" ]] && continue
                if   [[ "$pct" -ge 90 ]]; then bc='\033[31m'
                elif [[ "$pct" -ge 70 ]]; then bc='\033[33m'
                else                           bc='\033[32m'; fi
                user="${user:0:18}"
                printf "\033[33m%-18s\033[0m %6s (%2sj) ${bc}%s\033[0m %3s%%  %s\n" \
                       "$user" "$nodes" "$njobs" "$bar" "$pct" "$left"
            done
    } > "$TMP_RUN"

    # ── pending section → TMP_PND ─────────────────────────────────────────
    # Identical pending jobs (same user/account, nodes, time limit, reason) are grouped on one line
    # (×count, waiting = oldest~newest). The reason is made explicit:
    #   Priority/Resources → queue rank by SLURM priority among the eligible pending jobs of the
    #   partition, and the number of nodes requested by the jobs ahead of it; *Limit reasons → which
    #   limit; held jobs → by whom. Dependency jobs are not shown. PEND_ALL=1: one line per job.
    NOW_EPOCH=$(date +%s)
    {
        printf "\033[1m── Pending (≥%d nodes, grouped) ─────────\033[0m\n" "$PEND_MIN_NODES"
        printf "\033[90m%-18s %5s %4s %-10s %-24s %-11s %s\033[0m\n" \
               "USER" "NODES" "×" "limit" "reason" "waiting" "starts in"
        printf "\033[90m%.${COL_W}s\033[0m\n" \
               "────────────────────────────────────────────────────────────────────────────"

        squeue -p "$PARTITION" -h -t PENDING -o "%u|%a|%D|%V|%S|%j|%l|%R|%Q" 2>/dev/null \
          | awk -F'|' -v now="$NOW_EPOCH" -v me="$ME" -v minn="$PEND_MIN_NODES" -v all="${PEND_ALL:-0}" '
            function te(s,  cmd,ep){if(s==""||s=="N/A"||s=="(null)")return -1
                if(s in tcache)return tcache[s]
                cmd="date -d \""s"\" +%s 2>/dev/null";ep=-1;cmd|getline ep;close(cmd);tcache[s]=ep+0;return ep+0}
            function fs(s,  d,h,m){if(s<0)return "?"
                d=int(s/86400);s-=d*86400;h=int(s/3600);s-=h*3600;m=int(s/60)
                if(d>0)return d"d"sprintf("%02d",h)"h"
                if(h>0)return h"h"sprintf("%02d",m)"m";return m"m"}
            function kn(x){return (x>=10000)?sprintf("%.0fk",x/1000):(x>=1000)?sprintf("%.1fk",x/1000):x}
            function elig(r){return (r=="Priority"||r=="Resources")}
            # readable reason; rank/ahead only for jobs waiting for their turn
            function why(r,rk,ah){
                if(r=="Priority")  return "prio #"rk" ("kn(ah)"N ahead)"
                if(r=="Resources") return "next #"rk", needs nodes"
                if(r=="JobHeldAdmin") return "held by admin"
                if(r=="JobHeldUser")  return "held by user"
                if(r=="BeginTime")    return "begin time not reached"
                if(r~/ReqNodeNotAvail/) return "nodes unavail./reserved"
                if(r~/^Reservation/)   return "waiting reservation"
                if(r~/PartitionTimeLimit/) return "limit > partition max"
                if(r~/Limit$/){s=r;sub(/Limit$/,"",s);sub(/^AssocGrp/,"acct grp ",s);sub(/^AssocMax/,"acct max ",s)
                    sub(/^QOSGrp/,"QOS grp ",s);sub(/^QOSMax/,"QOS max ",s);return "lim: "s}
                return r}
            {
                if($8~/[Dd]ependency/)next
                n++;U[n]=$1;A[n]=$2;N[n]=$3+0;V[n]=$4;S[n]=$5;L[n]=$7;R[n]=$8;Q[n]=$9+0
            }
            END{
                # queue rank by priority among eligible jobs (all sizes, all users incl. me), nodes ahead
                m=0;for(i=1;i<=n;i++)if(elig(R[i]))o[++m]=i
                for(a=2;a<=m;a++){t=o[a];b=a-1;while(b>=1&&Q[o[b]]<Q[t]){o[b+1]=o[b];b--};o[b+1]=t}
                cum=0;for(a=1;a<=m;a++){i=o[a];RK[i]=a;AH[i]=cum;cum+=N[i]}
                g=0
                for(i=1;i<=n;i++){
                    if(U[i]==me||N[i]<minn)continue
                    r=R[i]; key=U[i]"/"A[i]"|"N[i]"|"L[i]"|"r; if(all)key=key"|"i
                    se=te(V[i]); ws=(se>0)?now-se:-1; st=te(S[i])
                    if(!(key in G)){G[key]=++g;K[g]=key;Gu[g]=U[i]"/"A[i];Gn[g]=N[i];Gl[g]=L[i];Gr[g]=r
                        Gc[g]=0;Gwmax[g]=-1;Gwmin[g]=-1;Grk[g]=-1;Gah[g]=0;Gst[g]=-1}
                    k=G[key];Gc[k]++
                    if(ws>Gwmax[k])Gwmax[k]=ws
                    if(ws>=0&&(Gwmin[k]<0||ws<Gwmin[k]))Gwmin[k]=ws
                    if(elig(r)&&(Grk[k]<0||RK[i]<Grk[k])){Grk[k]=RK[i];Gah[k]=AH[i]}
                    if(st>0&&(Gst[k]<0||st<Gst[k]))Gst[k]=st}
                # sort: nodes x count desc, then oldest
                for(a=1;a<=g;a++)srt[a]=a
                for(a=2;a<=g;a++){t=srt[a];b=a-1
                    while(b>=1&&(Gn[srt[b]]*Gc[srt[b]]<Gn[t]*Gc[t]||(Gn[srt[b]]*Gc[srt[b]]==Gn[t]*Gc[t]&&Gwmax[srt[b]]<Gwmax[t]))){srt[b+1]=srt[b];b--}
                    srt[b+1]=t}
                for(a=1;a<=g;a++){k=srt[a]
                    w=(Gc[k]>1&&Gwmin[k]>=0&&fs(Gwmin[k])!=fs(Gwmax[k]))?fs(Gwmax[k])"~"fs(Gwmin[k]):fs(Gwmax[k])
                    e=(Gst[k]>0)?fs(Gst[k]-now):"N/A"
                    printf "%s|%d|%d|%s|%s|%s|%s|%d\n",Gu[k],Gn[k],Gc[k],Gl[k],why(Gr[k],Grk[k],Gah[k]),w,e,Gwmax[k]}}' \
          | while IFS='|' read -r user nodes cnt jlimit reason wait eta wsec; do
                [[ -z "$user$nodes" ]] && continue
                if   [[ "$wsec" -ge 86400 ]]; then bc='\033[31m'
                elif [[ "$wsec" -ge 3600  ]]; then bc='\033[33m'
                else                               bc='\033[32m'; fi
                case "$reason" in
                    held*)            rc='\033[90m' ;;
                    lim:*)            rc='\033[35m' ;;
                    next*)            rc='\033[32m' ;;
                    *)                rc="$bc" ;;
                esac
                user="${user:0:18}"
                lim="${jlimit:0:10}"
                [[ "$cnt" -gt 1 ]] && cs="×$cnt" || cs=""
                printf "\033[34m%-18s\033[0m %5s %4s %-10s ${rc}%-24s\033[0m ${bc}%-11s\033[0m %s\n" \
                       "$user" "$nodes" "$cs" "$lim" "${reason:0:24}" "$wait" "$eta"
            done
    } > "$TMP_PND"

    # Remaining rows for side-by-side section
    n_map_rows=$(( (${#PCTS[@]} + MAP_COLS - 1) / MAP_COLS ))
    # n_myjobs: each non-empty section adds 1 header line + content + 1 blank
    if [[ -z "$MY_JOBS_RUNNING" && -z "$MY_JOBS_PENDING" ]]; then
        n_myjobs=1
    else
        n_myjobs=0
        [[ -n "$MY_JOBS_RUNNING" ]] && n_myjobs=$(( n_myjobs + 2 + $(printf '%b' "$MY_JOBS_RUNNING" | wc -l) ))
        [[ -n "$MY_JOBS_PENDING" ]] && n_myjobs=$(( n_myjobs + 2 + $(printf '%b' "$MY_JOBS_PENDING" | wc -l) ))
    fi
    header_lines=$(( 7 + n_map_rows + 2 + n_myjobs ))
    max_rows=$(( TERM_H - header_lines - 1 ))
    [[ $max_rows -lt 6 ]] && max_rows=15

    nr=$(wc -l < "$TMP_RUN"); np=$(wc -l < "$TMP_PND")
    # the longer column sets the height (the shorter one is padded), up to the screen height
    total_rows=$(( nr > np ? nr : np ))
    [[ $total_rows -gt $max_rows ]] && total_rows=$max_rows

    # ── print side by side using file descriptors ─────────────────────────
    exec 3< "$TMP_RUN"
    exec 4< "$TMP_PND"
    for (( r=0; r<total_rows; r++ )); do
        IFS= read -r -u 3 left_line  || left_line=""
        IFS= read -r -u 4 right_line || right_line=""
        ansi_pad "$left_line" "$COL_W"
        printf " \033[90m│\033[0m "
        printf '%s\n' "$right_line"
    done
    exec 3<&-; exec 4<&-
    rm -f "$TMP_RUN" "$TMP_PND"

    sleep "$INTERVAL"
done
